{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoftwarePortfolioView",
  "type": "object",
  "allOf": [{ "$ref": "../../view-common.schema.json#/$defs/viewHeader" }],
  "properties": {
    "view": { "type": "string", "const": "software-portfolio" },
    "viewVersion": { "type": "integer", "const": 1 },
    "pipelineVersion": { "type": "string" },
    "taxonomy": { "$ref": "../../view-common.schema.json#/$defs/resolvedTaxonomy" },
    "profile": { "$ref": "../../common.schema.json#/$defs/profile" },
    "filters": {
      "description": "Most used first.",
      "type": "object",
      "properties": {
        "tech": { "type": "array", "items": { "$ref": "../../common.schema.json#/$defs/slug" } },
        "tags": { "type": "array", "items": { "$ref": "../../common.schema.json#/$defs/slug" } }
      },
      "required": ["tech", "tags"],
      "additionalProperties": false
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "required": ["view", "viewVersion", "pipelineVersion", "taxonomy", "entries", "profile", "filters"],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "allOf": [{ "$ref": "../../view-common.schema.json#/$defs/entry" }],
      "properties": {
        "preview": {
          "type": "object",
          "description": "auto is already resolved: embeddable items with an owned live link frame it, others fall back to a screenshot.",
          "properties": {
            "kind": { "type": "string", "enum": ["none", "desktop", "phones", "laser-room", "screenshot"] },
            "urls": { "type": "array", "items": { "$ref": "../../common.schema.json#/$defs/httpUrl" } }
          },
          "required": ["kind", "urls"],
          "additionalProperties": false
        },
        "thumbnail": { "anyOf": [{ "$ref": "../../view-common.schema.json#/$defs/resolvedAsset" }, { "type": "null" }] },
        "richDescription": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "markdownUrl": { "anyOf": [{ "$ref": "../../common.schema.json#/$defs/httpUrl" }, { "type": "null" }] },
                "component": { "anyOf": [{ "$ref": "../../common.schema.json#/$defs/slug" }, { "type": "null" }] }
              },
              "required": ["markdownUrl", "component"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["preview", "thumbnail", "richDescription"],
      "unevaluatedProperties": false
    }
  }
}
